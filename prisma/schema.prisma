generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  compileEmailEnabled Boolean @default(false)
  createdAt    DateTime  @default(now())
  projects     Project[]

  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  skidlCode   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exports    Export[]
  components Component[]

  @@index([userId])
}

model Export {
  id        String   @id @default(cuid())
  filename  String
  fileType  String
  fileUrl   String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Component {
  id          String   @id @default(cuid())
  name        String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}
