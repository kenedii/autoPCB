# Environment Variables Configuration
# Copy this file to .env and fill in your secrets

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For Docker Compose, use: postgresql://postgres:password@db:5432/autopcb_db
# For local development: postgresql://postgres:password@localhost:5432/autopcb_db
DATABASE_URL="postgresql://postgres:password@localhost:5433/autopcb_db"

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Generate a secure JWT secret:
# Node:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OpenSSL: openssl rand -hex 32
JWT_SECRET="your-secret-jwt-key-change-this"

# ============================================================================
# AI SERVICE PROVIDERS
# ============================================================================
# At least ONE of these is required for the AI chat agent to function.
# Get API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - DeepSeek: https://deepseek.com (if available in your region)

OPENAI_API_KEY="sk-..."
DEEPSEEK_API_KEY="sk-..."

# ============================================================================
# EMAIL CONFIGURATION (Resend)
# ============================================================================
# Used for registration, verification, and compile completion notifications.
# Get your API key at: https://resend.com

# Your Resend API key (required)
RESEND_API_KEY="re_..."

# (Optional, development only)
# Override email recipient for sandbox/testing mode.
# All emails will be sent to this verified address instead of the user's email.
# Useful when testing with Resend's sandbox restrictions.
RESEND_TEST_EMAIL="your-verified-email@example.com"

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Used for absolute links in emails and API references.
# For Docker Compose: http://localhost:3000
# For local development: http://localhost:3001
# For production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================
# Google Analytics measurement ID
# Leave empty to disable analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# development | production | test
NODE_ENV="development"

