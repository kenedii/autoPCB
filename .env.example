# Environment Variables Configuration
# Copy this file to .env and fill in your secrets

# Database
# For Docker Compose, use: postgresql://postgres:password@db:5432/autopcb_db
DATABASE_URL="postgresql://postgres:password@localhost:5433/autopcb_db"

# Authentication
# Run `openssl rand -base64 32` to generate a secure secret
JWT_SECRET="your-secret-jwt-key"

# AI Service Providers
# Requires at least one of these for the Chat Agent to function
OPENAI_API_KEY="sk-..."
DEEPSEEK_API_KEY="sk-..."

# Email (Resend)
# Used for registration and verification
RESEND_API_KEY="re_..."

# Frontend Configuration
# used for absolute links in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."

# Node Environment
NODE_ENV="development"

